rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: products
    // Document ID: auto-generated by Firestore (not stored inside document fields)
    // Fields (EXACTLY 4 required fields, no extra fields allowed):
    //   - name: string (required, trimmed length >= 2, max 200 chars) - Product name
    //   - price: number (required, > 0, <= 1000000000000000) - Product price in VND
    //   - soluong: int (required, >= 0, <= 1000000000) - Stock quantity
    //   - image: string (required, 1..2048 chars, valid http/https URL) - Product image URL
    //
    // ===============================================================

    // ===============================================================
    // Helper Functions
    // ===============================================================

    // Check if the request comes from a signed-in Firebase Auth user.
    function isAuthenticated() {
      return request.auth != null;
    }

    // Check if the signed-in user is the designated Admin account.
    // Note: Firebase Console "Add user" creates users with email_verified == false
    // (and Emulator UI leaves it unchecked by default). For production hardening,
    // disable public self-signup in Firebase Auth Settings and/or require
    // `request.auth.token.email_verified == true` or custom claims (`admin == true`).
    function isAdmin() {
      return isAuthenticated()
        && 'email' in request.auth.token
        && request.auth.token.email is string
        && request.auth.token.email == 'admin@productadmin.com';
    }

    // Validate that all required fields exist on the resulting document.
    function hasRequiredFields(fields) {
      return request.resource.data.keys().hasAll(fields);
    }

    // Validate that no extraneous fields exist on the resulting document.
    function hasOnlyAllowedFields(fields) {
      return request.resource.data.keys().hasOnly(fields);
    }

    // Validate a required string field with max length and trimmed minimum length.
    function isValidTrimmedString(value, minTrimmedLen, maxLen) {
      return value is string
        && value.size() <= maxLen
        && value.trim().size() >= minTrimmedLen;
    }

    // Validate URL format (http:// for local Emulator, https:// for Cloud Storage/Web)
    // with bounded length to prevent resource exhaustion / 1MB payload attacks.
    function isValidUrl(url, maxLen) {
      return url is string
        && url.size() > 0
        && url.size() <= maxLen
        && (url.matches("^https://\\S+$") || url.matches("^http://\\S+$"));
    }

    // ===============================================================
    // Domain Validators (Used in BOTH create and update)
    // ===============================================================

    function isValidProduct(data) {
      let productFields = ['name', 'price', 'soluong', 'image'];
      return hasOnlyAllowedFields(productFields)
        && hasRequiredFields(productFields)
        && isValidTrimmedString(data.name, 2, 200)
        && data.price is number
        && data.price > 0
        && data.price <= 1000000000000000
        && data.soluong is int
        && data.soluong >= 0
        && data.soluong <= 1000000000
        && isValidUrl(data.image, 2048);
    }

    // ===============================================================
    // Collection Rules
    // ===============================================================

    match /products/{productId} {
      // Only the Admin can read (get/list) or delete products.
      allow read, delete: if isAdmin();

      // Only the Admin can create or update products, and every write must pass
      // strict 4-field schema, type, range, URL, and length validation.
      allow create, update: if isAdmin() && isValidProduct(request.resource.data);
    }

    // Default deny: block all other collections and subcollections.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
